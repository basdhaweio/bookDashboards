<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Library" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/library_bg</item>
        <item name="android:statusBarColor">@color/library_bg</item>
        <item name="android:navigationBarColor">@color/library_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="WidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:background">@drawable/widget_btn</item>
        <item name="android:textColor">@color/widget_btn_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
